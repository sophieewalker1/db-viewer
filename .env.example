# Prod server (the plain MSSQL_* vars)
MSSQL_SERVER=your-prod-host
MSSQL_PORT=1433
MSSQL_DATABASE=YourDatabase
MSSQL_DATABASES=YourDatabase,AnotherDatabase,ThirdDatabase
MSSQL_USER=your_user
# Quote passwords that contain @ or special characters
MSSQL_PASSWORD="your_password"

# Dev server (the MSSQL_*_LOCAL vars). Optional — needed for the Dev tab and Compare.
MSSQL_SERVER_LOCAL=127.0.0.1
MSSQL_PORT_LOCAL=1433
MSSQL_USER_LOCAL=dev_user
MSSQL_PASSWORD_LOCAL="dev_password"

# The compare ignore list lives in code: server/compareIgnore.js

# Optional (defaults: encrypt=true, trustServerCertificate=true)
# MSSQL_ENCRYPT=true
# MSSQL_TRUST_SERVER_CERTIFICATE=true

# Or use connection strings instead of the host/user/password vars above:
# MSSQL_CONNECTION_STRING=Server=...;Database=...;User Id=...;Password=...
# MSSQL_CONNECTION_STRING_LOCAL=Server=...;Database=...;User Id=...;Password=...

# API port (default 3001)
# PORT=3001
